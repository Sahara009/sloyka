# Скопируй в .env.local и заполни, когда будут ключи

# Оплата: yookassa (подходит самозанятым) или tbank. Пусто — берётся тот, чьи ключи заполнены.
PAYMENT_PROVIDER=yookassa

# ЮKassa — ЛК → Интеграция → Ключи API. Уведомления: https://<сайт>/api/payments/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Т-Банк (интернет-эквайринг / СБП) — выдаются в личном кабинете после подключения
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# СДЭК API v2 — Account и Secure из личного кабинета
CDEK_ACCOUNT=
CDEK_SECURE=
# 1 — тестовый контур СДЭК (api.edu.cdek.ru) с тестовыми ключами из документации
CDEK_TEST=

# Ozon доставка — ключи из кабинета продавца
OZON_CLIENT_ID=
OZON_API_KEY=

# Яндекс Метрика (загружается только после согласия на cookie)
NEXT_PUBLIC_YM_ID=

# Адрес сайта (для SEO и ссылок возврата после оплаты)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# База данных PostgreSQL (Neon, Supabase, Timeweb, свой сервер)
# пример: postgresql://user:password@host:5432/sloyka?schema=public
DATABASE_URL=
# откуда брать каталог: static — из src/data (по умолчанию), db — из базы (правится в админке)
CATALOG_SOURCE=static

# Админ-панель /admin
ADMIN_PASSWORD=
# случайная строка от 16 символов, например результат: openssl rand -hex 32
ADMIN_SECRET=
