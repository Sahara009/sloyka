TELEGRAM_CHAT_ID=

# Яндекс Метрика (загружается только после согласия на cookie). Пока не заводим (03.11)
NEXT_PUBLIC_YM_ID=
# Яндекс Вебмастер: код из мета-тега подтверждения сайта (только значение content)
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Адрес сайта (для SEO и ссылок возврата после оплаты)
